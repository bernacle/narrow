{
  "name": "jobhunt-web",
  "private": true,
  "description": "Narrow (narrow.fyi) on the web: the few opportunities worth your time, over the JobHunt Cloud API.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "next dev --port 3000",
    "build": "next build",
    "start": "next start --port ${PORT:-3000}",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "types": "node scripts/generate-types.mjs",
    "types:check": "node scripts/generate-types.mjs --check",
    "e2e": "playwright test",
    "check": "npm run types:check && npm run typecheck && npm run lint && npm run test && npm run build",
    "stack": "node e2e/stack.mjs --dev"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "5.3.0",
    "geist": "1.7.2",
    "jose": "6.2.12",
    "next": "16.3.8",
    "openid-client": "6.8.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/compat": "2.1.1",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "axe-core": "4.13.0",
    "eslint": "10.11.0",
    "eslint-config-next": "16.3.8",
    "jsdom": "30.1.1",
    "json-schema-to-typescript": "16.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.2",
    "vitest": "5.0.3"
  }
}
